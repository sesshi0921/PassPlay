{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://passplay.local/schemas/plugin-manifest.schema.json",
  "title": "PassPlay Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "apiVersion",
    "entry",
    "icon",
    "description",
    "min",
    "permissions",
    "assets"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "apiVersion": {
      "const": "1.0"
    },
    "entry": {
      "type": "string",
      "pattern": "^[^/][^\\\\]*\\.html$"
    },
    "icon": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "min": {
      "type": "integer",
      "minimum": 1
    },
    "max": {
      "type": "integer",
      "minimum": 1
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "players:read",
          "storage:read",
          "storage:write",
          "navigation",
          "room:read",
          "room:write"
        ]
      }
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "single",
          "multi"
        ]
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
